# Gabarit d'environnement pour la stack locale (infra/docker-compose.yml).
# Copier en `.env` a la racine. Ne jamais versionner de valeur reelle.
#
# Tous les mots de passe sont declares obligatoires dans le compose : la stack
# refuse de demarrer sans eux, plutot que de retomber sur une valeur devinable.

# Base de donnees PostgreSQL — role PROPRIETAIRE `zumm` (superutilisateur du
# conteneur). Sert aux migrations Flyway (droits DDL) et a Keycloak.
DB_PASSWORD=changez-moi

# Role APPLICATIF non-superutilisateur `zumm_app`, cree par la migration V3.
# L'application s'y connecte pour que la RLS soit effective (un superutilisateur
# la contournerait — ADR-001). Ce mot de passe alimente a la fois la creation du
# role (placeholder Flyway) et la source de donnees applicative : une seule valeur.
DB_APP_USER=zumm_app
DB_APP_PASSWORD=changez-moi-aussi

# Administration Keycloak (console d'administration du fournisseur d'identite).
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=changez-moi

# Interface Grafana.
GRAFANA_PASSWORD=changez-moi

# Profil Spring actif : dev | prod
SPRING_PROFILES_ACTIVE=dev

# Emetteur OIDC valide contre le claim « iss » des jetons. En mono-hote, l'URL
# interne par defaut (http://keycloak:8080/realms/zumm) convient. EN PRODUCTION,
# derriere le proxy inverse, la definir sur l'URL PUBLIQUE de Keycloak (celle que
# portent les jetons emis pour le navigateur), et regler KC_HOSTNAME sur la meme
# valeur cote Keycloak. Ne jamais laisser vide.
# ZUMM_OIDC_ISSUER_URI=https://auth.exemple.tn/realms/zumm

# Image PostgreSQL. Defaut : image locale construite par
# infra/test-postgres.Dockerfile (PostGIS + TimescaleDB).
# Cible de production : timescale/timescaledb-ha:pg16-ts2.14
# POSTGRES_IMAGE=timescale/timescaledb-ha:pg16-ts2.14

# ─── BFF : session de navigateur sans jeton (ADR-006) ───────────────────────
# Le back-end mene lui-meme le flux OIDC et garde les jetons cote serveur ; le
# navigateur ne recoit qu'un cookie HttpOnly. Cela suppose un client Keycloak
# CONFIDENTIEL — donc un secret, qui ne doit jamais entrer dans le depot.
#
# En developpement, le realm `realm-zumm.dev.json` fixe `secret-bff-dev` pour
# que la pile locale demarre sans reglage. En production, generer une valeur
# aleatoire et la faire correspondre au client `zumm-bff` du realm :
#   openssl rand -base64 32
ZUMM_BFF_CLIENT=zumm-bff
ZUMM_BFF_SECRET=secret-bff-dev
