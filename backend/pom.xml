<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.zumm</groupId>
  <artifactId>zumm-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Zumm Backend</name>
  <description>SIG apicole de gestion et de suivi de ruchers</description>

  <properties>
    <!-- Bytecode 17 conformement a l'annexe B, quel que soit le JDK de developpement. -->
    <java.version>17</java.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Surcharge la version geree par Spring Boot (1.20.4) : son docker-java
         est anterieur a Docker Engine 29 (API minimale 1.40) et echoue avec un
         HTTP 400 a la decouverte du demon. -->
    <testcontainers.version>1.21.4</testcontainers.version>
    <!-- Plancher de couverture (SPRINT-14). Regle sur la couverture REELLE
         constatee, arrondie a l'inferieur : c'est un cliquet anti-regression, pas
         une cible. Le relever se fait en meme temps qu'on ajoute des tests ; le
         baisser demande un geste explicite et visible en revue. -->
    <!-- Mesure du 26/07/2026 : 82,5 % (9 659 / 11 701 instructions), campagnes
         unitaire et integration fusionnees. Plancher pose a 0,80 — sous la mesure,
         pour tolerer le bruit d'un test, et tres au-dessus des 70 % de la DoD. -->
    <couverture.minimale>0.80</couverture.minimale>

    <!-- ─── Correctifs de securite au-dessus du BOM Spring Boot ───
         Trois versions relevees au-dessus de ce que gere le BOM de Boot 3.5.16,
         pour fermer des vulnerabilites qu'il ne couvre pas encore. Ce sont des
         correctifs de patch, sans changement d'API.

         A REEXAMINER a chaque montee de Boot : dès que le BOM gere une version
         superieure ou egale, ces surcharges deviennent du bruit et doivent
         disparaitre. Une surcharge oubliee finit par BLOQUER une mise a jour au
         lieu de la devancer.

         - jackson-databind  : GHSA-5gvw-p9qm-jgwh, GHSA-mhm7-754m-9p8w (6.5),
                               GHSA-5jmj-h7xm-6q6v (5.3)
         - commons-lang3     : GHSA-j288-q9x7-2f5v (6.5)
         - postgresql        : GHSA-j92g-9f8w-j867 (8.2) — le pilote parle au
                               SGBD qui detient toutes les donnees. -->
    <jackson-bom.version>2.21.5</jackson-bom.version>
    <commons-lang3.version>3.18.0</commons-lang3.version>
    <postgresql.version>42.7.12</postgresql.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Notifications e-mail des alertes de seuil (SPRINT-09). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <!-- AOP : aspect du journal d'audit (SPRINT-09). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>
    <!-- Generation PDF des rapports de visite (SPRINT-09) : OpenPDF (LGPL/MPL). -->
    <dependency>
      <groupId>com.github.librepdf</groupId>
      <artifactId>openpdf</artifactId>
      <version>1.3.30</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <!-- Sessions en BASE plutot qu'en memoire (SPRINT-17). Le BFF (ADR-006) a
         introduit une session serveur : tant qu'elle vit dans le tas d'une seule
         instance, le back-end ne peut ni etre replique ni redemarre sans
         deconnecter tout le monde. Spring Session la deporte dans PostgreSQL —
         deja present, deja sauvegarde, deja sous surveillance. C'est la dette que
         l'ADR-006 signalait comme « a traiter avant toute mise a l'echelle ». -->
    <dependency>
      <groupId>org.springframework.session</groupId>
      <artifactId>spring-session-jdbc</artifactId>
    </dependency>
    <!-- BFF (ADR-006) : le back-end est AUSSI client OAuth2. Il mene le flux
         Authorization Code + PKCE pour le navigateur et garde les jetons cote
         serveur ; le navigateur ne recoit qu'un cookie HttpOnly. Les deux roles
         cohabitent : serveur de ressources pour les machines porteuses de jeton,
         client pour les sessions humaines. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
    </dependency>
    <!-- Contrat OpenAPI 3 (US-026) : publie /v3/api-docs et Swagger UI. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.8.4</version>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Nom attendu par infra/Dockerfile (cf. 03_devops_pipeline/Dockerfile). -->
    <finalName>zumm</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Les tests d'integration (*IT) exigent Docker : joues par `mvn verify`,
           pas par `mvn test`, afin que la boucle de developpement reste rapide. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Couverture de code (SPRINT-14). La Definition of Done du backlog exige
           >= 70 % depuis le SPRINT-01 ; rien ne le MESURAIT, donc rien ne le
           garantissait. JaCoCo instrumente les deux campagnes — unitaire
           (surefire) et integration (failsafe) — et fusionne les deux releves :
           compter la seule campagne unitaire sous-estimerait tres largement un
           projet dont l'essentiel des regles est prouve par les tests
           d'integration Testcontainers.

           Le seuil est un PLANCHER de non-regression, pas un objectif. Il est
           regle sur la couverture reelle constatee, arrondie a l'inferieur : le
           faire descendre demande alors un geste explicite. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution>
            <id>prepare-unitaires</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>prepare-integration</id>
            <goals>
              <goal>prepare-agent-integration</goal>
            </goals>
          </execution>
          <execution>
            <id>fusion</id>
            <phase>verify</phase>
            <goals>
              <goal>merge</goal>
            </goals>
            <configuration>
              <fileSets>
                <fileSet>
                  <directory>${project.build.directory}</directory>
                  <includes>
                    <include>jacoco.exec</include>
                    <include>jacoco-it.exec</include>
                  </includes>
                </fileSet>
              </fileSets>
              <destFile>${project.build.directory}/jacoco-fusion.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>rapport</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
            <configuration>
              <dataFile>${project.build.directory}/jacoco-fusion.exec</dataFile>
              <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>seuil</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <dataFile>${project.build.directory}/jacoco-fusion.exec</dataFile>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${couverture.minimale}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
              <excludes>
                <!-- Point d'entree Spring Boot : une ligne, testee par le seul
                     fait que le contexte demarre dans chaque test d'integration. -->
                <exclude>com/zumm/ZummApplication.class</exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
